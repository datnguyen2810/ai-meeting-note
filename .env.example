# Database Configuration (Neon / Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_database_password_here

# JWT Secret Key
JWT_SECRET=ai-meeting-note-super-secret-key-change-in-production-2024


# AI service: tóm tắt/chat bằng Gemini API (bỏ trống khóa thì dùng Qwen local)
# Lấy khóa ở https://aistudio.google.com/api-keys ; LLM_BACKEND=local để ép dùng Qwen
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_BACKEND=
# Model thử tiếp khi model chính quá tải (503); none để tắt
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
